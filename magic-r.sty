% R evaluates values (\mrValue), printed output (\mrEval), and sessions. Each
% query names its context: the file it is answered in (\mrSource), and a
% session its own environment. The runtime below is written to the script
% first; it marks every answer with '@@mr:<n>@@' and ends it with its time
% and whether it failed, '@@mr-stat:<ms>:ok@@'.
\def\mr@R@runtime{Sys.setenv(LANGUAGE = "en"); options(width = 80, warn = 1);
.mr <- new.env(); .mr$envs <- list();
.mr$one <- function(s) paste(trimws(strsplit(s, "[[:cntrl:]]")[[1]]), collapse = " ");
.mr$env <- function(ctx, file) { ctx <- paste0("@", ctx); if (is.null(.mr$envs[[ctx]])) { e <- new.env(parent = globalenv());
  if (nzchar(file)) tryCatch(sys.source(file, envir = e), error = function(c) writeLines(paste("@@mr-load:", .mr$one(conditionMessage(c)))));
  .mr$envs[[ctx]] <- e }; .mr$envs[[ctx]] };
.mr$run <- function(x, e, mode, out) { err <- FALSE; res <- utils::capture.output(withCallingHandlers(tryCatch({
  v <- withVisible(eval(x, e)); if (mode == "value" || mode == "last") writeLines(paste(format(v$value), collapse = ", ")) else if (v$visible && mode != "silent") print(v$value) },
  error = function(c) { err <<- TRUE; writeLines(paste("Error:", .mr$one(conditionMessage(c)))) }),
  warning = function(w) { writeLines(paste("Warning:", .mr$one(conditionMessage(w)))); invokeRestart("muffleWarning") },
  message = function(m) { writeLines(sub("[[:space:]]+$", "", conditionMessage(m))); invokeRestart("muffleMessage") }));
  if (mode == "silent") res <- grep("^Error:", res, value = TRUE); if (mode == "last" && !err) res <- res[length(res)];
  if (length(res)) writeLines(paste0(out, res)); err };
.mr$prompts <- function(buf) writeLines(paste0(c(":prompt:", rep(":cont:", length(buf) - 1)), buf));
.mr$q <- function(marker, ctx, file, mode, lines) { writeLines(c("", paste0("@@mr:", marker, "@@"))); e <- .mr$env(ctx, file);
  t0 <- proc.time()[[3]]; err <- FALSE;
  if (mode == "session") { buf <- character(); for (l in lines) { if (!length(buf) && !nzchar(trimws(l))) next; buf <- c(buf, l);
    p <- tryCatch(parse(text = buf, keep.source = FALSE), error = function(c) if (grepl("end of input", conditionMessage(c))) NULL else c);
    if (is.null(p)) next; .mr$prompts(buf); buf <- character();
    if (inherits(p, "error")) { err <- TRUE; writeLines(paste0(":out:Error: ", .mr$one(conditionMessage(p)))) } else for (x in p) err <- .mr$run(x, e, "print", ":out:") || err;
    writeLines("@@step@@") };
    if (length(buf)) { .mr$prompts(buf); err <- TRUE; writeLines(c(":out:Error: incomplete input", "@@step@@")) } }
  else { p <- tryCatch(parse(text = lines, keep.source = FALSE), error = function(c) c);
    if (inherits(p, "error")) { err <- TRUE; writeLines(paste("Error:", .mr$one(conditionMessage(p)))) }
    else for (i in seq_along(p)) err <- .mr$run(p[[i]], e, if (mode != "yield") mode else if (i < length(p)) "silent" else "last", "") || err };
  writeLines(paste0("@@mr-stat:", round((proc.time()[[3]] - t0) * 1000), ":", if (err) "error" else "ok", "@@")) }}
