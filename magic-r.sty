    \ifdefined\hypertarget\mr@target{mr.#1.\mr@token}\fi{\colorlet{mr@plain}{.}\csname mr@style@#2\endcsname#3}%
  \else\mr@iflocal{\colorlet{mr@plain}{.}\hyperlink{mr.#1.\mr@token}{\mr@underline{\csname mr@style@#2\endcsname#3}}}%
