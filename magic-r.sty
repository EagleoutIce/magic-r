\AtEndDocument{\def\mr@definition#1#2#3#4{%
  \ifcsname mr@known@\detokenize{#1}@#2\endcsname\else\global\mr@userreruntrue\fi}%
  \def\mr@argument#1#2{\ifcsname mr@arg@#1@#2\endcsname\else\global\mr@userreruntrue\fi}%
  \def\mr@notpkg#1#2{\ifcsname mr@notpkg@#1@#2\endcsname\else\global\mr@userreruntrue\fi}%
