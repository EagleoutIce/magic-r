    \ifx\mr@firstdef\relax\def\mr@firstdef{{#1}{#2}}\def\mr@firstgroup{#3}\else
      \ifnum#3=\mr@firstgroup\relax\def\mr@firstdef{{#1}{#2}}\fi\fi
