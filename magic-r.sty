\lst@AddToHook{EOL}{\global\let\mr@pending\@empty\ifx\mr@rhs\@empty\else\mr@rhsdef{var}\fi\mr@popif\mr@endexpr
  \global\mr@linestarttrue\global\let\mr@lastword\relax\global\mr@memberfalse\gdef\mr@libstate{0}%
  \global\advance\mr@line\@ne\ifcsname mr@loads@\the\mr@lstid @\the\mr@line\endcsname
