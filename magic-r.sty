% magic-r.sty
% R listings for xlistings: names link to their documentation (the R manual,
% rdrr.io) or to their definition, packages attach as in R, operators become
% ligatures that copy as plain text. flowR finds the packages of a document.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{magic-r}[2026/10/10 version v1.0 R listings with documentation links]

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=mr,prefix=mr@}
\DeclareBoolOption[true]{links}
\DeclareBoolOption[true]{locallinks}% names link to their definitions in the document
\DeclareBoolOption[true]{ligatures}
\DeclareBoolOption[true]{tight}
\DeclareBoolOption{symbols}% operators as symbols ('<-' as an arrow), they copy as text
\DeclareBoolOption[true]{underline}
\DeclareBoolOption{strict}% link only names of attached packages
\DeclareStringOption[magic-r-links]{database}
\DeclareStringOption[mr]{language}
\DeclareStringOption[auto]{flowr}% auto, always, never, or off
\DeclareStringOption{flowr-backend}% node, docker, r, web
\DeclareStringOption{flowr-version}% '2.15.10', '>=2.15'
\DeclareStringOption{flowr-command}% the flowR command line to run, e.g. of a local build
\DeclareStringOption{flowr-image}% the docker image of flowR, e.g. eagleoutice/flowr:2.15.10
\DeclareStringOption{flowr-engine}% lax (tree-sitter, the default), tree-sitter, r-shell
\DeclareBoolOption{flowr-required}% no flowR is an error
\DeclareBoolOption{dependencies}% highlight lines that read, write, ...
\DeclareBoolOption{operators}% link operators and keywords to R's help
\DeclareStringOption[dim]{slices}% dim: gray out what a slice drops, hide: leave it out
\DeclareStringOption[none]{index}% usage, ssa, or none: the default of the key mrindex
\DeclareBoolOption{lint}% flowR's linter for every listing
\DeclareBoolOption{graphs-gray}% the graphs in shades of gray
\DeclareBoolOption{graphs-legend}% a legend below dataflow graphs
\DeclareBoolOption{graphs-lines}% the line of its code in every node of a graph
\DeclareBoolOption{graphs}% load TikZ for \mrDataflowGraph and \mrControlFlowGraph
\DeclareStringOption[auto]{arrowroute}% auto: arrows to a definition above over the top where they can, or side
\DeclareBoolOption{playground}% a button beside every listing opens it in flowR's playground
\DeclareStringOption{interactive}[on]% on: the key mrinteractive works, all: every listing is interactive
\DeclareBoolOption{eval}
\DeclareStringOption{xlistings}
\DeclareBoolOption[true]{cleanup}% the script removes side files of older versions ('\jobname.mr-play-3.R')
\ProcessKeyvalOptions*
\let\mrLanguage\mr@language

% the directory of magic-r when a document loads it by its path ('_config/magic-r/magic-r'),
% where it finds its database and its script without TEXINPUTS; empty if kpathsea found it
\edef\mr@dir{\CurrentFilePath}
\def\mr@ownfile#1{\ifx\mr@dir\@empty#1\else\mr@dir/#1\fi}
% an xlistings the document loaded already, also by its path, is used as it is
\def\mr@xlistings@min{2026/08/17}
\ifdefined\xlstGetStyle
  \ifx\mr@xlistings\@empty\else\PackageWarning{magic-r}{xlistings is loaded already, so the option
    xlistings={\mr@xlistings} has no effect. Give the options to xlistings itself}\fi
\else
  \expandafter\RequirePackage\expandafter[\mr@xlistings]{xlistings}
\fi
\@ifpackagelater{xlistings}{\mr@xlistings@min}{}{\PackageWarning{magic-r}{xlistings is older than
  \mr@xlistings@min, the oldest version magic-r works with. Update xlistings}}
\RequirePackage{etoolbox}

% \mr@map\f{text} passes each character of the text to \f, which appends to
% \mr@out; a '\' that escapes a character ('\%') is dropped
\def\mr@map#1#2{\def\mr@out{}\let\mr@f#1\expandafter\mr@map@\detokenize{#2}\@nil}
\def\mr@map@#1{\ifx\@nil#1\else\ifnum`#1=92 \else\mr@f#1\fi\expandafter\mr@map@\fi}
\def\mr@keep#1{\edef\mr@out{\mr@out#1}}
\def\mr@apart#1{\edef\mr@out{\mr@out#1{}}}% no font ligatures ('>>')
\def\mr@count#1{\edef\mr@out{\the\numexpr\mr@out+1}}
\def\mr@len#1{\mr@map\mr@count{#1}\edef\mr@out{\the\numexpr0\mr@out}}
\def\mr@str#1{\mr@map\mr@keep{#1}}
% listings writes most non-letters as \lst@um<char>, digits through xlistings
% as \xlst@dgt{<digit>}; with \mr@plain, a token expands to its characters
\def\mr@plain{\let\lst@nolig\@empty\def\lst@outputspace{ }\def\xlst@dgt##1{##1}%
  \def\xlst@pfx##1##2{##2}\def\textunderscore{_}\let\mr@op\@firstofone
  \mr@umdefs}
\begingroup\def\mr@out{}\count@=32
\loop\advance\count@\@ne\ifnum\count@<127
  \begingroup\lccode`\~=\count@\lowercase{\endgroup
    \edef\mr@out{\unexpanded\expandafter{\mr@out}\noexpand\@namedef{lst@um\string~}{\string~}}}%
\repeat
\expandafter\endgroup\expandafter\def\expandafter\mr@umdefs\expandafter{\mr@out}
% \mr@token: the characters of \lst@token
\def\mr@tokenname{\begingroup\mr@plain\edef\mr@out{\the\lst@token}\edef\mr@out{\mr@out}%
  \xdef\mr@token{\detokenize\expandafter{\mr@out}}\endgroup}

% the colors are those of xlistings, e.g. \lstcolorlet{keywordB}{...}
\colorlet{mr@colors@prompt}{gray}
\colorlet{mrlink}{gray!14}
\colorlet{mr@plain}{.}
\def\mr@style@func{\xlstGetStyle{keywordC}}% names of packages
\def\mr@style@user{\xlstGetStyle{keywordC}}% functions defined in the document
\def\mr@style@var{\mr@style@plain}%           variables defined in the document
\def\mr@style@pkg{\xlstGetStyle{keywordB}}%  'dplyr' in 'dplyr::filter' and 'library(dplyr)'
\def\mr@style@op{\@declaredcolor{mr@colors@prompt}}
\def\mr@style@plain{\color{mr@plain}}% links keep the color around them
\def\mr@style@arg{}% the names of named arguments ('n' in 'head(x, n = 3)')
\def\mr@style@data{\mr@style@plain}% data sets of packages ('relig_income'), as variables
% \mrSetStyle{kind}{style} sets the style of a kind of name, e.g. \mrSetStyle{user}{\color{gray}}
\def\mr@stylename@function{func}\def\mr@stylename@variable{var}\def\mr@stylename@parameter{param}
\def\mr@stylename@package{pkg}\def\mr@stylename@operator{op}\def\mr@stylename@argument{arg}
\newcommand\mrSetStyle[2]{\edef\mr@t{\ifcsname mr@stylename@#1\endcsname\csname mr@stylename@#1\endcsname\else#1\fi}%
  \ifcsname mr@style@\mr@t\endcsname\expandafter\def\csname mr@style@\mr@t\endcsname{#2}\else
  \PackageError{magic-r}{No style '#1'}{The kinds are function, user, variable, parameter, package, data, operator,
    and argument}\fi}
\def\mrPrompt#1{\textcolor{mr@colors@prompt}{#1}}
\if@xlst@accuspp@available@
\def\mr@copyas#1#2{\BeginAccSupp{method=escape,ActualText={#1}}#2\EndAccSupp{}}
\def\mr@nocopy#1{\BeginAccSupp{method=hex,ActualText={}}#1\EndAccSupp{}}
\else
\def\mr@copyas#1#2{#2}\def\mr@nocopy#1{#1}
\fi
\AtBeginDocument{\ifdefined\href\let\mr@href\href\else\def\mr@href#1#2{#2}\mr@underlinefalse\fi
  \ifdefined\hyperlink\else\def\hyperlink#1#2{#2}\fi}

\def\mrUnderlineDepth{1.3pt}
\def\mrUnderlineThickness{.4pt}
\newbox\mr@box % listings uses \@tempboxa itself, and \aftergroup (hence the group)
\def\mr@underline#1{\ifmr@underline\setbox\mr@box\hbox{\begingroup#1\endgroup}%
  \rlap{\color{mrlink}\rule[-\mrUnderlineDepth]{\wd\mr@box}{\mrUnderlineThickness}}%
  \box\mr@box\else#1\fi}
% #1 style, #2 url (empty: neither link nor highlighting), #3 text
\def\mr@show#1#2#3{\ifx\relax#2\relax#3\else
  \ifmr@links\colorlet{mr@plain}{.}\mr@href{#2}{\mr@underline{\csname mr@style@#1\endcsname#3}}\else
  {\csname mr@style@#1\endcsname#3}\fi\fi}
% as \mr@show, but without the underline: operators and keywords (option operators) link quietly
\def\mr@quietshow#1#2#3{\ifx\relax#2\relax#3\else
  \ifmr@links\colorlet{mr@plain}{.}\mr@href{#2}{\csname mr@style@#1\endcsname#3}\else
  {\csname mr@style@#1\endcsname#3}\fi\fi}

% \mrPackage[scheme]{package}{version}{entries} stores the entries of a
% package; only the packages a document uses are read (\mr@load). An entry
% \N{names} links names to the help topics of the same name, \T{topic}{names}
% to a topic, \U{url}{names} to any page, \S{names} are the S3 generics, whose
% methods ('print.foo') link to them, \D{names} are no functions (data sets), plain as the
% variables of the document. A later \mrPackage replaces an
% earlier one, so the database of the document (flowR) wins.
\newcommand\mrPackage[4][cran]{\ifcsname mr@loaded@#2\endcsname\else
  \csgdef{mr@db@#2}{#4}\csgdef{mr@scheme@#2}{#1}\csgdef{mr@version@#2}{#3}\fi}
\def\mr@load#1{\ifcsname mr@loaded@#1\endcsname\else\csgdef{mr@loaded@#1}{}%
  \ifcsname mr@db@#1\endcsname\begingroup\def\mr@pkg{#1}%
    \let\N\mr@db@N\let\T\mr@db@T\let\U\mr@db@U\let\S\mr@db@S\let\D\mr@db@D\csname mr@db@#1\endcsname\endgroup
    \global\cslet{mr@db@#1}\@empty\fi\fi}
\def\mr@db@N{\mr@db@names{}}
\def\mr@db@T#1{\mr@str{#1}\expandafter\mr@db@names\expandafter{\expandafter\mr@t\expandafter{\mr@out}}}
\def\mr@db@U#1{\mr@str{#1}\expandafter\mr@db@names\expandafter{\expandafter\mr@u\expandafter{\mr@out}}}
\def\mr@db@D#1{\def\mr@list{#1}\@for\mr@n:=\mr@list\do{\ifx\mr@n\@empty\else
  \expandafter\mr@str\expandafter{\mr@n}\csgdef{mr@data@\mr@pkg @\mr@out}{}\fi}}
\def\mr@db@S#1{\def\mr@list{#1}\@for\mr@n:=\mr@list\do{\ifx\mr@n\@empty\else
  \expandafter\mr@str\expandafter{\mr@n}\csgdef{mr@S@\mr@out}{}\fi}}
% #1 target (empty: the name), #2 names; \mr@K@<name> lists the packages
\def\mr@db@names#1#2{\def\mr@list{#2}\def\mr@target{#1}%
  \@for\mr@n:=\mr@list\do{\ifx\mr@n\@empty\else\expandafter\mr@str\expandafter{\mr@n}%
    \ifx\mr@target\@empty\csxdef{mr@L@\mr@pkg @\mr@out}{\noexpand\mr@t{\mr@out}}%
    \else\global\expandafter\let\csname mr@L@\mr@pkg @\mr@out\endcsname\mr@target\fi
    \csxappto{mr@K@\mr@out}{{\mr@pkg}}\fi}}
% the links of the document come first, they are the package '.'
\newcommand*\mrAddLink[2]{\begingroup\def\mr@pkg{.}\mr@db@U{#1}{#2}\endgroup}
\newcommand*\mrNoLink[1]{\mrAddLink{}{#1}}
\csgdef{mr@scheme@.}{cran}
\newcommand*\mrVersion[1]{\ifcsname mr@version@#1\endcsname\csname mr@version@#1\endcsname\fi}
\newcommand*\mrLoadPackage[1]{\forcsvlist\mr@load{#1}}

% the documentation: R's manual for its own packages, rdrr.io for CRAN
\def\mrDocsRManual{https://stat.ethz.ch/R-manual/R-devel/library}
\def\mrDocsCran{https://rdrr.io/cran}
\def\mrCran{https://cran.r-project.org/package=}
% #1 package, #2 topic
\def\mr@url@rman#1#2{\mrDocsRManual/#1/html/#2.html}
\def\mr@url@cran#1#2{\mrDocsCran/#1/man/#2.html}
\def\mr@pkgurl@rman#1{\mrDocsRManual/#1/html/00Index.html}
\def\mr@pkgurl@cran#1{\mrCran#1}
\def\mr@pkgurl#1{\ifcsname mr@scheme@#1\endcsname\csname mr@pkgurl@\csname mr@scheme@#1\endcsname\endcsname{#1}\fi}

% \mr@path lists the attached packages, the last one attached first, as R does
\def\mr@path{}
\def\mr@attach#1{\mr@load{#1}\mr@detach{#1}\xdef\mr@path{{\detokenize{#1}}\unexpanded\expandafter{\mr@path}}}
\def\mr@detach#1{\def\mr@t{}\edef\mr@w{\detokenize{#1}}%
  \expandafter\mr@detach@\mr@path\@nil\global\let\mr@path\mr@t}
\def\mr@detach@#1{\ifx\@nil#1\else\def\mr@n{#1}\ifx\mr@n\mr@w\else
  \edef\mr@t{\unexpanded\expandafter{\mr@t}{#1}}\fi\expandafter\mr@detach@\fi}
\newcommand*\mrAttach[1]{\forcsvlist\mr@attach{#1}}
\newcommand*\mrDetach[1]{\forcsvlist\mr@detach{#1}}
% the packages R attaches at startup, the first one is searched first
\newcommand*\mrSearchPath[1]{\gdef\mr@path{}\def\mr@t{#1}%
  \@for\mr@n:=\mr@t\do{\expandafter\mr@attach\expandafter{\mr@n}}}
\def\mrDefaultSearchPath{base,methods,datasets,utils,grDevices,graphics,stats}
% packages the document uses (aux file, flowR) are read up front, so that a
% name links to them before they are attached ('strict' turns this off)
\def\mr@uses#1{\ifcsname mr@used@#1\endcsname\else\csgdef{mr@used@#1}{}\gappto\mr@used{{#1}}\fi}
\def\mr@used{}
\let\mrUses\mr@uses
\AtBeginDocument{\mr@readflowr\expandafter\mrSearchPath\expandafter{\mrDefaultSearchPath}%
  \ifmr@strict\else\expandafter\@tfor\expandafter\mr@n\expandafter:\expandafter=\mr@used\do{\expandafter\mr@load\expandafter{\mr@n}}\fi}

% \mr@found: {style}{url} of a name, else {plain}{}: the first attached package
% exporting it, else the first package the document uses
\def\mr@resolve#1{\def\mr@found{{plain}{}}\ifcsname mr@K@#1\endcsname
  \def\mr@key{#1}\let\mr@hit\relax\expandafter\mr@search\expandafter{\expandafter.\expandafter}\mr@path\@nil
  \ifx\mr@hit\relax\ifmr@strict\else\expandafter\expandafter\expandafter\mr@first\csname mr@K@#1\endcsname\@nil\fi\fi
  \ifx\mr@hit\relax\else\mr@found@in\mr@hit{#1}\fi
  \else\ifcsname mr@s3@#1\endcsname\edef\mr@t{\csname mr@s3@#1\endcsname}\expandafter\mr@resolve\expandafter{\mr@t}\fi\fi}
\def\mr@search#1{\ifx\@nil#1\else\ifx\mr@hit\relax
  \ifcsname mr@L@#1@\mr@key\endcsname\def\mr@hit{#1}\fi\fi\expandafter\mr@search\fi}
% the first package, unless it only re-exports the name ('%>%' of dplyr)
\def\mr@first#1#2\@nil{\def\mr@hit{#1}\expandafter\ifx\csname mr@L@#1@\mr@key\endcsname\mr@reexport
  \ifx\relax#2\relax\else\mr@first#2\@nil\ifx\mr@hit\relax\def\mr@hit{#1}\fi\fi\fi}
\def\mr@reexport{\mr@t{reexports}}
% #1 package, #2 name: \mr@found if the package exports it
\def\mr@found@in#1#2{\ifcsname mr@L@#1@#2\endcsname
  \def\mr@t##1{\csname mr@url@\csname mr@scheme@#1\endcsname\endcsname{#1}{##1}}\let\mr@u\@firstofone
  \edef\mr@found{{\ifcsname mr@data@#1@#2\endcsname data\else func\fi}{\csname mr@L@#1@#2\endcsname}}\fi}
\def\mr@resolve@in#1#2{\def\mr@found{{plain}{}}\mr@load{#1}\mr@found@in{#1}{#2}}

% Words are looked up when listings detects keywords, i.e. as whole words and
% never within strings or comments. A word is a name of R ('.' and '_' are
% letters), and ':' is a letter too, so 'dplyr::filter' is one word.
\lst@AddToHook{DetectKeywords}{\ifmr@active\ifmr@quiet\else\mr@tokenname
  \ifcsname mr@K@\mr@token\endcsname\let\lst@thestyle\mr@keyword\fi
  \ifcsname mr@user@\mr@token\endcsname\let\lst@thestyle\mr@keyword\fi
  \ifcsname mr@K@\mr@token\endcsname\else\mr@genericcheck\ifcsname mr@s3@\mr@token\endcsname\let\lst@thestyle\mr@keyword\fi\fi
  \expandafter\in@\expandafter:\expandafter{\mr@token}\ifin@\let\lst@thestyle\mr@keyword\fi\fi\fi}
% #1 typeset word; \mr@token its name, \mr@role what the code around makes of it
\def\mr@keyword#1{\ifx\mr@role\mr@role@sparam\mr@sparamdef{#1}\else\ifx\mr@role\mr@role@flow\mr@flowlink{#1}\else\ifx\mr@role\mr@role@ext\mr@libraryword{#1}\else
  \ifx\mr@role\mr@role@plain#1\else
  \ifx\mr@role\mr@role@def\ifcsname mr@user@\mr@token\endcsname\expandafter\mr@linkword\expandafter{\mr@token}{#1}\else#1\fi\else
  \expandafter\in@\expandafter:\expandafter{\mr@token}%
  \ifin@\expandafter\mr@colons\mr@token\@nil\else
  \ifx\mr@role\mr@role@pkg\mr@pkgname\mr@token\else
  \mr@scopedword{#1}\fi\fi\fi\fi\fi\fi\fi}
\def\mr@argword#1{{\mr@style@arg#1}}
\def\mr@role@flow{flow}\def\mr@role@ext{ext}\def\mr@role@sparam{sparam}
\def\mr@role@plain{plain}\def\mr@role@pkg{pkg}\def\mr@role@def{def}\def\mr@role{}
% #1 name, #2 typeset word
\def\mr@linkword#1#2{\def\mr@token{#1}%
  \ifcsname mr@user@#1\endcsname\mr@userlink{#2}\else
  \mr@resolve{#1}\expandafter\mr@show\mr@found{#2}\fi}
\def\mr@name#1{\mr@linkword{#1}{#1}}
\def\mr@pkgname#1{\mr@load{#1}\ifcsname mr@scheme@#1\endcsname
  \mr@show{pkg}{\mr@pkgurl{#1}}{#1}\else{\mr@style@pkg#1}\fi}
% 'pkg::name' and 'pkg:::name' link into the package, other colons are the
% operator ':' between names or numbers ('1:n', 'a:b'). \mr@parts: the parts as
% \mr@P{name} and \mr@S{colons}; \mr@shape: P and S for each, as in 'PSP'
\def\mr@colons#1\@nil{\def\mr@parts{}\def\mr@shape{}\def\mr@cur{}\def\mr@run{}%
  \mr@map\mr@colchar{#1}\mr@colpart\mr@colsep
  \ifx\mr@shape\mr@qualshape\expandafter\mr@qualified\mr@parts\else
  \begingroup\let\mr@P\mr@flowpart\let\mr@S\mr@flowops\mr@parts\endgroup\fi}
\def\mr@qualshape{PSP}
\def\mr@colchar#1{\if:#1\mr@colpart\edef\mr@run{\mr@run:}\else\mr@colsep\edef\mr@cur{\mr@cur#1}\fi}
\def\mr@colpart{\ifx\mr@cur\@empty\else\eappto\mr@parts{\noexpand\mr@P{\mr@cur}}\appto\mr@shape{P}\def\mr@cur{}\fi}
\def\mr@colsep{\ifx\mr@run\@empty\else\eappto\mr@parts{\noexpand\mr@S{\mr@run}}\appto\mr@shape{S}\def\mr@run{}\fi}
\def\mr@ops#1{\ifmr@operators\ifcsname mr@nsop@#1\endcsname
  \mr@quietshow{op}{\mrDocsRManual/base/html/ns-dblcolon.html}{#1}\else{\mr@style@op#1}\fi\else{\mr@style@op#1}\fi}
\expandafter\let\csname mr@nsop@\detokenize{::}\endcsname\@empty
\expandafter\let\csname mr@nsop@\detokenize{:::}\endcsname\@empty
\edef\mr@two{\detokenize{::}}\edef\mr@three{\detokenize{:::}}
\def\mr@qualified\mr@P#1\mr@S#2\mr@P#3{\def\mr@t{#2}\in@false
  \ifx\mr@t\mr@two\in@true\fi\ifx\mr@t\mr@three\in@true\fi
  \ifin@\mr@pkgname{#1}\mr@ops{#2}\mr@resolve@in{#1}{#3}\expandafter\mr@show\mr@found{#3}%
  \else\mr@part{#1}\mr@ops{#2}\mr@part{#3}\fi}
% with flowR, each part is looked up at its column
\def\mr@flowpart#1{\ifx\mr@flowcol\relax\mr@part{#1}\else
  \edef\mr@flowat{\the\mr@lstid @\the\numexpr\mr@line+1\relax @\mr@flowcol}%
  \ifcsname mr@fl@\mr@flowat\endcsname\begingroup\def\mr@token{#1}\let\mr@role\@empty
    \csname mr@fl@\mr@flowat\endcsname\ifx\mr@role\@empty\mr@part{#1}\else\mr@keyword{#1}\fi\endgroup
  \else\mr@part{#1}\fi\mr@len{#1}\edef\mr@flowcol{\the\numexpr\mr@flowcol+\mr@out}\fi}
\def\mr@flowops#1{\mr@ops{#1}\ifx\mr@flowcol\relax\else\mr@len{#1}\edef\mr@flowcol{\the\numexpr\mr@flowcol+\mr@out}\fi}
\let\mr@flowcol\relax
\def\mr@part#1{\mr@isnumber{#1}\ifin@{\xlstGetStyle{numbers}#1}\else\mr@name{#1}\fi}
\def\mr@isnumber#1{\expandafter\mr@isnumber@\detokenize{#1}\@nil}
\def\mr@isnumber@#1#2\@nil{\in@{#1}{0123456789}}

% '%op%' names of the database and ligatures are literates; listings replaces
% literates everywhere, so they skip strings and comments themselves.
\def\mr@code#1#2{\lst@ifkeywords#1\else#2\fi}
% #1 operator as a string
\def\mr@op#1{\mr@map\mr@apart{#1}\let\mr@opchars\mr@out\mr@code
  {\ifcsname mr@K@#1\endcsname\mr@resolve{#1}\else\def\mr@found{{plain}{}}\fi
   \edef\mr@t{\@car#1\@nil}\ifx\mr@t\mr@percent\let\mr@shower\mr@show\else\let\mr@shower\mr@opshow\fi
   \expandafter\mr@shower\mr@found{\ifmr@symbols\ifcsname mr@sym@#1\endcsname\mr@copyas{#1}{\csname mr@sym@#1\endcsname}%
     \else\mr@ligature{#1}\fi\else\mr@ligature{#1}\fi}}
  {\mr@opchars}}
\def\mr@ligature#1{\ifmr@ligatures\ifcsname mr@lig@#1\endcsname
     \mr@copyas{#1}{\csname mr@lig@#1\endcsname}\else\mr@opchars\fi\else\mr@opchars\fi}
% an operator of R's syntax keeps its color, '%op%' is a function of a package
\def\mr@opshow#1#2{\mr@quietshow{plain}{#2}}
\edef\mr@percent{\expandafter\@gobble\string\%}
\def\mr@maxlen{0}
% #1 operator as typed ('\%in\%'): registered once, shortest first
\def\mr@addop#1{\mr@str{#1}\ifcsname mr@isop@\mr@out\endcsname\else\csgdef{mr@isop@\mr@out}{}%
  \edef\mr@t{\noexpand\mr@op{\mr@out}}\mr@len{#1}%
  \ifnum\mr@out>\mr@maxlen\relax\global\let\mr@maxlen\mr@out\fi
  \ifcsname mr@ops@\mr@out\endcsname\else\csgdef{mr@ops@\mr@out}{}\fi
  \csgappto{mr@ops@\mr@out}{{#1}}\csxappto{mr@ops@\mr@out}{{{\unexpanded\expandafter{\mr@t}}}{\mr@out}}\fi}
\newcount\mr@cnt
\def\mr@literates{\advance\mr@cnt\@ne
  \ifcsname mr@ops@\the\mr@cnt\endcsname
    \expandafter\expandafter\expandafter\xlst@lst@addToLiterate
    \expandafter\expandafter\expandafter{\csname mr@ops@\the\mr@cnt\endcsname}\fi
  \ifnum\mr@cnt<\mr@maxlen\relax\expandafter\mr@literates\fi}
