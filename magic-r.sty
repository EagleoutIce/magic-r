\def\mr@argument#1#2{\csgdef{mr@arg@#1@#2}{}}

% In a displayed listing, a name that starts a line is defined once '<-',
% '<<-', or '=' follows: a function if 'function' or '\(' comes next, else a
% variable; an indented one only within its listing. Definitions go to the
% aux file, so from the next run on every use links to the definition in the
% same listing, else the last one before, else the first one after.
\newif\ifmr@defs
\newif\ifmr@defhere
\newif\ifmr@userrerun
\newif\ifmr@private
\newif\ifmr@indented
