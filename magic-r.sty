\def\mr@definition#1#2#3#4{\edef\mr@t{\detokenize{#1}}%
  \csxappto{mr@user@\mr@t}{{#2}{#3}{#4}}\csgdef{mr@known@\mr@t @#2}{}%
  \def\mr@n{#3}\ifx\mr@n\mr@kind@param\else\csgdef{mr@knownv@\mr@t @#2}{}\fi}
