  morestring=[s]{r"(}{)"},morestring=[s]{r"-(}{)-"},morestring=[s]{r"--(}{)--"},morestring=[s]{r"[}{]"},
  morestring=[s]{r"-[}{]-"},morestring=[s]{r"--[}{]--"},morestring=[s]{r"\{}{\}"},morestring=[s]{r"-\{}{\}-"},
  morestring=[s]{r"--\{}{\}--"},morestring=[s]{R"(}{)"},morestring=[s]{R"-(}{)-"},morestring=[s]{R"--(}{)--"},
  morestring=[s]{R"[}{]"},morestring=[s]{R"-[}{]-"},morestring=[s]{R"--[}{]--"},morestring=[s]{R"\{}{\}"},
  morestring=[s]{R"-\{}{\}-"},morestring=[s]{R"--\{}{\}--"},morestring=[s]{r'(}{)'},morestring=[s]{r'-(}{)-'},
  morestring=[s]{r'--(}{)--'},morestring=[s]{r'[}{]'},morestring=[s]{r'-[}{]-'},morestring=[s]{r'--[}{]--'},
  morestring=[s]{r'\{}{\}'},morestring=[s]{r'-\{}{\}-'},morestring=[s]{r'--\{}{\}--'},morestring=[s]{R'(}{)'},
  morestring=[s]{R'-(}{)-'},morestring=[s]{R'--(}{)--'},morestring=[s]{R'[}{]'},morestring=[s]{R'-[}{]-'},
  morestring=[s]{R'--[}{]--'},morestring=[s]{R'\{}{\}'},morestring=[s]{R'-\{}{\}-'},morestring=[s]{R'--\{}{\}--'},
  morestring=[b]",
  morestring=[b]',
  moredelim=**[is][{\mr@startmark{mrwarning}}]{|warn|}{|warn|},
  moredelim=**[is][{\mr@startmark{mrerror}}]{|err|}{|err|},
  moredelim=**[is][{\mr@startmark{mrinfo}}]{|info|}{|info|},
  moredelim=[is][{}]{|plain|}{|plain|},
  moredelim=[is][{\color{lightgray}}]{|dim|}{|dim|},
