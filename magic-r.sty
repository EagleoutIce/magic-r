% \begin{flowrsession}[animate, start=2, listing={...}, rcode] inputs \end{flowrsession}: flowR's
% REPL runs each line, a command (':dataflow* x <- 1', ':query ...') or R (with the key rcode, as
% flowR only runs R with its engine r-shell and --r-session-access), and the session shows each input
% after the prompt R> with what flowR prints for it. On beamer slides the inputs appear one after the
% other. The script answers \mrFlowrSession{name}{inputs} and a \mrFlowrSessionLine{name}{input}{hex}
% for every line of output (in hex, so that it may hold any character)
\int_new:N \g__mr_fsession_int
\bool_new:N \l__mr_rcode_bool
\str_new:N \l__mr_json_str
\keys_define:nn { magic-r / fsession }
  {
    animate .bool_set:N = \l__mr_animate_bool ,
    start   .int_set:N  = \l__mr_start_int ,
    listing .tl_set:N   = \l__mr_listing_tl ,
    rcode   .bool_set:N = \l__mr_rcode_bool ,
    rcode   .default:n  = true ,
  }
\NewDocumentCommand \mrFlowrSession { m m }
  {
    \cs_gset:cpn { mr@fs@ #1 } {#2}
    \int_step_inline:nn {#2} { \tl_gclear_new:c { mr@fsl@ #1 @ ##1 } }
  }
\NewDocumentCommand \mrFlowrSessionLine { m m m }
  {
    % pdfTeX keeps the bytes of UTF-8 (it has no characters above 255), LuaTeX and XeTeX the characters
    \bool_lazy_or:nnTF { \sys_if_engine_luatex_p: } { \sys_if_engine_xetex_p: }
      { \str_set_convert:Nnnn \l__mr_tmp_str {#3} { utf8/hex } { } }
      { \str_set_convert:Nnnn \l__mr_tmp_str {#3} { latin1/hex } { } }
    \tl_if_exist:cF { mr@fsl@ #1 @ #2 } { \tl_gclear_new:c { mr@fsl@ #1 @ #2 } }
    \tl_gput_right:ce { mr@fsl@ #1 @ #2 } { { \exp_not:V \l__mr_tmp_str } }
  }
\msg_new:nnn { magic-r } { fsession } { flowR~could~not~run~the~session~'#1':~#2 }
\NewDocumentCommand \mrFlowrSessionFailed { m m } { \msg_warning:nnnn { magic-r } { fsession } {#1} {#2} }
% a line as a string of JSON
\cs_new_protected:Npn \__mr_json_put:n #1
  {
    \str_set:Nn \l__mr_tmp_str {#1}
    \use:e
      {
        \exp_not:N \str_replace_all:Nnn \exp_not:N \l__mr_tmp_str { \c_backslash_str } { \c_backslash_str \c_backslash_str }
        \exp_not:N \str_replace_all:Nnn \exp_not:N \l__mr_tmp_str { " } { \c_backslash_str " }
        \exp_not:N \str_replace_all:Nnn \exp_not:N \l__mr_tmp_str { \char_generate:nn { 9 } { 12 } } { ~ }
      }
    \str_put_right:Ne \l__mr_json_str { \str_if_empty:NF \l__mr_json_str { , ~ } " \l__mr_tmp_str " }
  }
\cs_new_protected:Npn \__mr_fsession:nn #1#2
  {
    \group_begin:
    \bool_set:Nn \l__mr_animate_bool { \cs_if_exist_p:c { ver@beamer.cls } }
    \int_set:Nn \l__mr_start_int { 1 }
    \keys_set:nn { magic-r / fsession } {#1}
    \int_gincr:N \g__mr_fsession_int
    \tl_set:Ne \l__mr_gname_tl { fsession- \int_use:N \g__mr_fsession_int }
    \seq_clear:N \l__mr_lines_seq
    \ior_open:Nn \g__mr_ior {#2}
    \ior_str_map_inline:Nn \g__mr_ior { \tl_if_blank:nF {##1} { \seq_put_right:Nn \l__mr_lines_seq {##1} } }
    \ior_close:N \g__mr_ior
    \str_clear:N \l__mr_json_str
    \seq_map_function:NN \l__mr_lines_seq \__mr_json_put:n
    \__mr_request:nnnn { session } { \l__mr_gname_tl } { }
      { , ~ "inputs": [ \l__mr_json_str ] \bool_if:NT \l__mr_rcode_bool { , ~ "rcode": true } }
    \bool_set:Nn \l_mr_r_pending_bool { ! \cs_if_exist_p:c { mr@fs@ \l__mr_gname_tl } }
    % the steps: an input after the prompt (its command between invisible delimiters, styled), then
    % its output
    \seq_clear:N \l__mr_steps_seq
    \seq_map_indexed_inline:Nn \l__mr_lines_seq
      {
        \regex_extract_once:nnNTF { \A\s*(:\S*)(.*)\Z } {##2} \l_tmpa_seq
          {
            \tl_set:Ne \l__mr_step_tl
              { { :flowr: | fc | \seq_item:Nn \l_tmpa_seq { 2 } | fc | \seq_item:Nn \l_tmpa_seq { 3 } } }
          }
          { \tl_set:Nn \l__mr_step_tl { { :flowr: ##2 } } }
        \bool_if:NF \l_mr_r_pending_bool
          {
            \tl_if_exist:cT { mr@fsl@ \l__mr_gname_tl @ ##1 }
              { \tl_map_inline:cn { mr@fsl@ \l__mr_gname_tl @ ##1 } { \tl_put_right:Nn \l__mr_step_tl { { :out: ####1 } } } }
          }
        \seq_put_right:NV \l__mr_steps_seq \l__mr_step_tl
      }
    \int_set:Nn \l__mr_n_int { \seq_count:N \l__mr_steps_seq }
    \bool_if:NTF \l__mr_animate_bool
      {
        \int_step_inline:nn { \l__mr_n_int }
          {
            \__mr_session_file:n {##1}
            \use:e
              {
                \exp_not:N \only
                < \int_eval:n { \l__mr_start_int + ##1 - 1 } \int_compare:nNnT {##1} = \l__mr_n_int { - } >
              }
              { \__mr_fsession_typeset: }
          }
      }
      { \__mr_session_file:n { \int_use:N \l__mr_n_int } \__mr_fsession_typeset: }
    \bool_if:NT \l_mr_r_pending_bool { \mr@r@pending }
    \group_end:
  }
\cs_new_protected:Npn \__mr_fsession_typeset:
  {
    \use:e
      {
        \exp_not:N \mr@r@input { lFlowrConsole }
          { numbers=none, showlines=true, breaklines, \exp_not:V \l__mr_listing_tl } { \l__mr_file_str }
      }
  }
\newenvironment { flowrsession }
  {
    \tl_clear:N \l__mr_opts_tl
    \cs_set_eq:NN \do \@makeother \dospecials \char_set_catcode_active:N \^^M
    \peek_meaning:NTF [ \__mr_session_opts:w \__mr_session_start:
  }
  {
    \iow_close:N \g__mr_iow
    \exp_args:NV \__mr_fsession:nn \l__mr_opts_tl { \c_sys_jobname_str -mr-session.tmp }
  }
\ExplSyntaxOff

% listings do not nest: within one (e.g. in an escape) answers are plain text
\def\mr@r@format#1{\ifnum\lst@mode=\lst@nomode\csname b\mrLanguage\endcsname{#1}\else#1\fi}
\def\mr@r@value#1{#1}
\def\mr@r@error#1{\textcolor{mrerror}{\textbf{??}}}
\def\mr@r@pending{\textbf{??}}
\newcommand*\mrEvalSetFormat[1]{\def\mr@r@format##1{#1}}
\newcommand*\mrValueSetFormat[1]{\def\mr@r@value##1{#1}}
\newcommand*\mrSetErrorFormat[1]{\def\mr@r@error##1{#1}}
% #1 language, #2 options, #3 file; in the style of the fakeminted environment
\def\mr@r@input#1#2#3{\begingroup
  \ifdefined\xlst@minted@style
    \protected@edef\mr@t{style=\pgfkeysvalueof{/xlst@lst@family/\xlst@minted@style/listing style},}%
  \else\def\mr@t{}\fi
  \expandafter\endgroup\expandafter\lstinputlisting\expandafter[\mr@t language=#1,#2]{#3}}

% an R file written from the document, typeset, and the context of the
% queries that follow; #1 listing options, #2 file name
\newenvironment{mrfile}[2][]{%
  \def\mr@r@file{#2}\def\mr@r@fileopts{#1}%
  \begingroup\let\do\@makeother\dospecials\catcode`\^^M\active
  \def\verbatim@processline{\immediate\write\mr@r@out{\the\verbatim@line}}%
  \immediate\openout\mr@r@out=#2\relax\verbatim@start}
  {\immediate\closeout\mr@r@out\endgroup
  \mrSource{\mr@r@file}%
  \edef\mr@t{\noexpand\mr@r@input{lMagicR}{\unexpanded\expandafter{\mr@r@fileopts}}{\mr@r@file}}\mr@t}
\newwrite\mr@r@out
\endinput
