\AtBeginDocument{\if@filesw\immediate\write\@auxout{\string\providecommand\string\mr@definition[4]{}%
  \string\providecommand\string\mr@argument[2]{}\string\providecommand\string\mr@notpkg[2]{}\string\providecommand\string\mr@uses[1]{}\string\providecommand\string\mr@agsave[3]{}}\fi}
