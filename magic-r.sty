\def\mr@scan#1#2#3{\ifx\@nil#1\else
  \ifnum#1=\mr@lstid\def\mr@t{#2}\ifx\mr@t\mr@kind@param\ifx\mr@exact\relax\def\mr@exact{{#1}{#2}}\fi
    \else\def\mr@exact{{#1}{#2}}\fi\fi
