\def\mr@target#1{\smash{\raise\dimexpr\ht\strutbox+\dp\strutbox\relax\hbox{\hypertarget{#1}{}}}}
% #1 listing, #2 kind, #3 typeset word; the first binding is the target
\def\mr@userlink@#1#2#3{\in@false
