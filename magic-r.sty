  \ifx\mr@exact\relax\ifx\mr@below\relax\mr@iflater\else\let\mr@exact\mr@below\fi\fi
  \ifx\mr@exact\relax\let\mr@t\mr@libraryword\else\edef\mr@t{\noexpand\mr@userlink@\mr@exact}\fi
