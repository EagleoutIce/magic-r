% the overlays of a frame form a group; the group -1 marks a listing whose
% definitions only count within it
\def\mr@group{\ifmr@private-1\else\ifdefined\beamer@slideinframe\the\c@framenumber
  \else\the\mr@lstid\fi\fi}
