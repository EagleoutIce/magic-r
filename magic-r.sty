  mr cgmain/.style={rounded rectangle,draw=mrg-def!75,line width=.8pt,fill=gray!4},
  mr cgfun/.style={mr vdef},
  mr cgbuiltin/.style={rounded rectangle,draw=gray!45,fill=gray!5,text=gray!75!black},
  mr block/.style={sharp corners,fill=gray!4,font=\ttfamily\scriptsize},
