% write is not immediate: code in a box that is never shipped out (beamer's
% \only on another overlay) defines nothing
\def\mr@define#1{\def\mr@t{#1}\ifx\mr@t\mr@kind@param\def\mr@t{p}\else\let\mr@t\@empty\fi
  \ifcsname mr@seen\mr@t @\mr@token @\the\mr@lstid\endcsname\else
  \csgdef{mr@seen\mr@t @\mr@token @\the\mr@lstid}{}%
  \mr@write{\string\mr@definition{\mr@token}{\the\mr@lstid}{#1}{\mr@group}}\fi}
\def\mr@write#1{\if@filesw\edef\mr@t{\noexpand\mr@write@\@auxout{#1}}\mr@t\fi}
\let\mr@write@\write
\def\mr@usesaux#1{\if@filesw\immediate\write\@auxout{\string\mr@uses{#1}}\fi}
