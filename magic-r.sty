\cs_new_protected:Npn \__mr_session:nn #1#2
  {
    \group_begin:
    \bool_set:Nn \l__mr_animate_bool { \cs_if_exist_p:c { ver@beamer.cls } }
    \int_set:Nn \l__mr_start_int { 1 }
    \bool_set:Nn \l__mr_session_play_bool { \legacy_if_p:n { mr@playground } }
    \keys_set:nn { magic-r / session } {#1}
    \int_gincr:N \g__mr_session_int
    \seq_clear:N \l__mr_lines_seq
    \ior_open:Nn \g__mr_ior {#2}
    \ior_str_map_inline:Nn \g__mr_ior { \seq_put_right:Nn \l__mr_lines_seq {##1} }
    \ior_close:N \g__mr_ior
    % a session is an environment of its own, named by its inputs, as beamer
    % typesets a frame once per overlay
    \str_set:Ne \l__mr_ctx_str { \exp_args:NNV \seq_use:Nn \l__mr_lines_seq \c__mr_nl_str }
    \str_set_eq:NN \l__mr_tmp_str \g__mr_r_ctx_str
    \str_gset:Ne \g__mr_r_ctx_str { \g__mr_r_ctx_str | \exp_args:NV \str_mdfive_hash:n \l__mr_ctx_str }
    \exp_args:NV \__mr_r_query:nn \l__mr_ctx_str { session }
    \str_gset_eq:NN \g__mr_r_ctx_str \l__mr_tmp_str
    \bool_if:NT \l__mr_session_play_bool { \__mr_session_play: }
    % the steps: the lines of R up to each '@@step@@'
    \seq_clear:N \l__mr_steps_seq
    \tl_clear:N \l__mr_step_tl
    \bool_if:NTF \l_mr_r_pending_bool
      { \seq_put_right:Ne \l__mr_steps_seq { \seq_map_function:NN \l__mr_lines_seq \__mr_prompt:n } }
      {
        \tl_map_inline:Nn \l_mr_r_lines_tl
          {
            \str_if_eq:nnTF {##1} { @@step@@ }
              { \seq_put_right:NV \l__mr_steps_seq \l__mr_step_tl \tl_clear:N \l__mr_step_tl }
              { \tl_put_right:Nn \l__mr_step_tl { {##1} } }
          }
        \tl_if_empty:NF \l__mr_step_tl { \seq_put_right:NV \l__mr_steps_seq \l__mr_step_tl }
      }
    \int_set:Nn \l__mr_n_int { \seq_count:N \l__mr_steps_seq }
    \bool_if:NTF \l__mr_animate_bool
      {
        \int_step_inline:nn { \l__mr_n_int }
          {
            \__mr_session_file:n {##1}
            \use:e
              {
                \exp_not:N \only
                < \int_eval:n { \l__mr_start_int + ##1 - 1 } \int_compare:nNnT {##1} = \l__mr_n_int { - } >
              }
              { \__mr_session_typeset: }
          }
      }
      { \__mr_session_file:n { \int_use:N \l__mr_n_int } \__mr_session_typeset: }
    \group_end:
  }
