\tl_new:N \l__mr_gname_tl
\cs_new_protected:Npn \__mr_graph:nnn #1#2#3
  {
    \group_begin:
    \legacy_if:nTF { mr@graphs-legend } { \bool_set_true:N \l__mr_legend_bool } { \bool_set_false:N \l__mr_legend_bool }
    \legacy_if:nTF { mr@graphs-lines } { \bool_set_true:N \l__mr_glines_bool } { \bool_set_false:N \l__mr_glines_bool }
    \tl_set:Nn \l__mr_rowsep_tl { 0.2 }
    \keys_set_known:nnN { magic-r / graph } {#2} \l__mr_tikz_clist
    % the answer of another flowR has a name of its own
    \str_set:Ne \l_tmpa_str { \str_mdfive_hash:e { \tl_to_str:N \l__mr_instance_tl } }
    % several listings (#3: 'a,b') give a name without commas
    \str_set:Ne \l_tmpb_str { \tl_to_str:n {#3} }
    \str_replace_all:Nnn \l_tmpb_str { ~ } { }
    \str_replace_all:Nnn \l_tmpb_str { , } { _ }
    \tl_set:Ne \l__mr_gname_tl
      {
        #1- \l_tmpb_str \tl_if_empty:NF \l__mr_gfun_tl { - \tl_to_str:N \l__mr_gfun_tl }
        \tl_if_empty:NF \l__mr_instance_tl { - \str_range:Nnn \l_tmpa_str { 1 } { 8 } }
        \bool_if:NT \l__mr_glines_bool { -lines }
      }
    \bool_if:NTF \l__mr_mermaid_bool
      {
        % only a link to the graph on mermaid.live, as flowR draws it
        \__mr_request:nnnn { mermaid } { mermaid- \l__mr_gname_tl } {#3} { , ~ "graph":" #1 " }
        \cs_if_exist:cTF { mr@mermaid@ mermaid- \l__mr_gname_tl }
          {
            \cs_if_exist:NTF \href
              {
                \tl_set:Ne \l_tmpa_tl { \exp_not:N \href { \use:c { mr@mermaid@ mermaid- \l__mr_gname_tl } } }
                \l_tmpa_tl { \l__mr_mermaid_tl }
              }
              { \l__mr_mermaid_tl }
          }
          { \mr@r@pending }
      }
      {
        \__mr_request:nnnn {#1} { \l__mr_gname_tl } {#3}
          {
            , ~ "rowsep": " \tl_to_str:N \l__mr_rowsep_tl "
            \tl_if_empty:NF \l__mr_gfun_tl { , ~ "function": " \tl_to_str:N \l__mr_gfun_tl " }
            \bool_if:NT \l__mr_glines_bool { , ~ "lines": true }
          }
        \bool_if:NTF \l__mr_legend_bool { \mr@legendtrue } { \mr@legendfalse }
        \cs_if_exist:cTF { mr@graph@ \l__mr_gname_tl }
          {
            \cs_if_exist:NTF \tikzpicture
              {
                \tl_set:Ne \l_tmpa_tl { \exp_not:c { mr@graph@ \l__mr_gname_tl } { \exp_not:V \l__mr_tikz_clist } }
                \tl_use:N \l_tmpa_tl
              }
              { \msg_error:nn { magic-r } { graphs } }
          }
          { \mr@r@pending }
      }
    \group_end:
  }
