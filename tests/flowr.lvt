    \ior_close:N \g_tmpa_ior
  }
\ExplSyntaxOff
\begin{document}
\WarmUp
\START
\TEST{used before attached}{\Typeset{\bmr{pivot_longer}}\ShowPath}
\BeginBox{attached where flowR says}
\begin{mr}
pkgs <- "tidyr"
library(pkgs, character.only = TRUE)
pivot_longer(x)
\end{mr}
\EndBox
\TEST{attached}{\ShowPath}
\BeginBox{code}
\begin{mr}
x <- 1:10 %in% c(2, 0x1F, 1e-3)   # a comment: "quoted" \ { } $ & ~ ^
	s <- 'it''s'; f <- \(a) a$b@c
\end{mr}
\EndBox
\BeginBox{console listings are output}
\begin{rconsole}
:prompt:1 + 1
:out:[1] 2
\end{rconsole}
\EndBox
\EndDocumentHooks
