\input{regression-test}
\documentclass{article}
\usepackage[database=testlinks]{magic-r}
\usepackage{mrtest}
\mrFlowrRun{never}
\ExplSyntaxOn
\cs_new_protected:Npn \ShowCode
  {
    \ior_open:Nn \g_tmpa_ior { \c_sys_jobname_str .mr.R }
