% Without flowR: roxygen comments, '->', assign(), parameters, character.only,
% and definitions in console listings.
\input{regression-test}
\documentclass{article}
\usepackage[database=testlinks,flowr=off]{magic-r}
\usepackage{hyperref}
\usepackage{mrtest}
\begin{document}
\WarmUp
\START
\BeginBox{roxygen}
\begin{mr}
#' The sum, see [base::sum()] and mean
#' @param values the numbers
#' @export
total <- function(values, na.rm = FALSE) sum(values)
\end{mr}
\EndBox
\BeginBox{right assignment and assign}
\begin{mr}
1:3 -> right
assign("assigned", right)
c(right, assigned)
get("assigned") + exists("right")
\end{mr}
\EndBox
\TEST{elsewhere}{\Typeset{\bmr{right assigned values}}}
\BeginBox{character.only}
\begin{mr}
for (p in c("dplyr")) library(p, character.only = TRUE)
library(tidyr)
\end{mr}
\EndBox
\TEST{only tidyr is attached}{\ShowPath}
\BeginBox{console}
\begin{rconsole}
:prompt:x <- c(1, 2)
:prompt:mean(x)
:out:[1] 1.5 mean x
\end{rconsole}
\EndBox
\END
