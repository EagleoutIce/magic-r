% A session of flowR's REPL: each input after the prompt (its command between
% the invisible delimiters |fc|), then what flowR printed for it, from the
% answer of the script (hex, so that any character comes through: % # { } \).
% The request names its inputs as JSON strings.
\input{regression-test}
\documentclass{article}
\usepackage[database=testlinks]{magic-r}
\usepackage{mrtest}
\mrFlowrRun{never}
\begin{document}
\WarmUp
\START
\BeginBox{a session}
\begin{flowrsession}
:dataflow* x <- "a\b"
x + 1
\end{flowrsession}
\EndBox
\EndDocumentHooks
\ExplSyntaxOn
\TEST{the~request}
  {
    \ior_open:Nn \g_tmpa_ior { \c_sys_jobname_str .mr.R }
    \ior_str_map_inline:Nn \g_tmpa_ior { \str_if_in:nnT {#1} { "session" } { \TYPE { REQUEST:~#1 } } }
    \ior_close:N \g_tmpa_ior
  }
\ExplSyntaxOff
\END
