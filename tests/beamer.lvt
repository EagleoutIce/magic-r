% Everything in beamer: frames are typeset once per overlay, so links,
% definitions, markers, and animated R sessions must hold on every one.
\input{regression-test}
\documentclass{beamer}
\usepackage[database=testlinks,flowr=off,eval]{magic-r}
\usepackage{mrtest}
\mrRRun{never}
\setbeamertemplate{navigation symbols}{}
\begin{document}
\WarmUp
\START
\SEPARATOR\TYPE{TEST: use before the definition links to its last overlay}
\begin{frame}[fragile]
\bmr{size(1)}
\end{frame}
\SEPARATOR\TYPE{TEST: listing and overlays}
\begin{frame}[fragile]
\begin{mr}
size <- function(x) length(x)
library(dplyr)
\end{mr}
\only<2>{\bmr{size(filter) \%>\% mutate}}
\end{frame}
\SEPARATOR\TYPE{TEST: markers and qualified names}
\begin{frame}[fragile]
\begin{mr}
go <- |warn|stats::sd(x)|warn| |> sum
\end{mr}
\end{frame}
\SEPARATOR\TYPE{TEST: animated session}
\begin{frame}[fragile]
\begin{rsession}
xs <- 1:3
sum(xs)
xs * 2
\end{rsession}
\end{frame}
\SEPARATOR\TYPE{TEST: session from overlay 2}
\begin{frame}[fragile]
\mrSessionSetup{start=2}
\begin{rsession}
prod(1:4)
\end{rsession}
\end{frame}
\SEPARATOR\TYPE{TEST: pause within a listing, then a use in the next frame}
\begin{frame}[fragile]
\begin{mr}
twice <- !*\pause*! function(x) x + x
\end{mr}
\end{frame}
\begin{frame}[fragile]
\bmr{twice(2)}
\end{frame}
\EndDocumentHooks
\END
